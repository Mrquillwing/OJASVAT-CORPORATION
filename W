<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Portfolio</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
    scroll-behavior:smooth;
}
body{
    background:#0f172a;
    color:white;
}

/* Welcome Screen */
#welcome{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100vh;
    background:#000;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:38px;
    font-weight:bold;
    animation:hide 3s forwards;
    z-index:9999;
}
#welcome span{
    color:#00e5ff;
}
@keyframes hide{
    0%,80%{opacity:1;}
    100%{
        opacity:0;
        visibility:hidden;
    }
}

header{
    background:#111827;
    padding:20px;
    position:sticky;
    top:0;
    text-align:center;
}
header a{
    color:white;
    text-decoration:none;
    margin:15px;
    font-weight:bold;
}
header a:hover{
    color:#00e5ff;
}

.hero{
    height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
}
.hero h1{
    font-size:55px;
}
.hero p{
    margin-top:15px;
    color:#ccc;
}

section{
    padding:80px 20px;
}
h2{
    text-align:center;
    margin-bottom:30px;
    color:#00e5ff;
}

.container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:#1e293b;
    padding:20px;
    border-radius:15px;
    transition:.3s;
}
.card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 20px cyan;
}

.img{
    width:100%;
    height:180px;
    background:#334155;
    border-radius:10px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#bbb;
    margin-bottom:15px;
}

footer{
    background:#111827;
    text-align:center;
    padding:20px;
    margin-top:40px;
}
</style>

</head>
<body>

<div id="welcome">
    Hi! <span>&nbsp;Welcome To My Portfolio</span>
</div>

<header>
    <a href="#projects">Projects</a>
    <a href="#artworks">Artworks</a>
</header>

<div class="hero">
    <h1>Hello, I'm Specteer</h1>
    <p>Programmer • Artist • Developer</p>
</div>

<section id="projects">
    <h2>My Personal Projects</h2>

    <div class="container">

        <div class="card">
            <h3>Project 1</h3>
            <p>Add your project description here.</p>
        </div>

        <div class="card">
            <h3>Project 2</h3>
            <p>Add your project description here.</p>
        </div>

        <div class="card">
            <h3>Project 3</h3>
            <p>Add your project description here.</p>
        </div>

    </div>
</section>

<section id="artworks">
    <h2>My Artworks</h2>

    <div class="container">

        <div class="card">
            <div class="img">Artwork Image</div>
            <p>Artwork Title</p>
        </div>

        <div class="card">
            <div class="img">Artwork Image</div>
            <p>Artwork Title</p>
        </div>

        <div class="card">
            <div class="img">Artwork Image</div>
            <p>Artwork Title</p>
        </div>

    </div>
</section>

<footer>
    © 2026 Specteer | My Portfolio
</footer>

</body>
</html>
